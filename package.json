{
  "name": "schichtplan-mvp",
  "version": "0.4.91",
  "private": true,
  "scripts": {
    "check:syntax": "node --check schichtplan_mvp.js && node --check tests/smoke.spec.js && node --check playwright.config.js && node --check js/article-master.js && node --check tests/articles.spec.js && node --check scripts/ci-report.js && node --check js/operations.js && node --check tests/operations.spec.js && node --check tests/helpers/operations-db.js && node --check js/machine-readiness.js && node --check tests/readiness.spec.js && node --check tests/helpers/readiness-db.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium --project=mobile-chromium --project=tablet-chromium",
    "test:cross-browser": "playwright test --project=firefox --project=webkit",
    "test:visual": "node scripts/run-visual.js",
    "test:agents": "playwright test -c playwright.agents.config.js",
    "test:qa": "node --test tests/qa/*.test.js",
    "test:db:preflight": "node scripts/db-preflight.js",
    "qa:check": "node scripts/qa-check.js",
    "qa:agent-server": "node scripts/check-agent-server.js",
    "test:ci": "node --test scripts/ci-report.test.js",
    "test:articles": "playwright test --grep \"Article master\"",
    "test:article-db": "node --test tests/articles/*.test.js",
    "test:operations": "node --test tests/operations/*.test.js",
    "test:readiness": "node --test tests/readiness/*.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.62.1",
    "@zxing/library": "0.21.3",
    "jsbarcode": "3.12.3",
    "pngjs": "7.0.0",
    "yaml": "2.9.1"
  }
}
